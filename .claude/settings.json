    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .git*)",
      "Bash(rm -rf docs*)",
      "Bash(rm -rf .claude*)",
      "Bash(sudo *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(git remote *)",
      "Bash(npm publish)",
      "Bash(npm publish *)",
      "Bash(cargo publish)",
      "Bash(cargo publish *)",
      "Bash(curl * | *)",
      "Bash(wget * | *)",
      "Edit(//etc/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  }
}
