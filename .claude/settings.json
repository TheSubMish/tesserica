{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "Skill",

      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",

      "Bash(cargo *)",
      "Bash(rustc *)",
      "Bash(rustup *)",

      "Bash(git *)",

      "Bash(ls *)",
      "Bash(find *)",
      "Bash(rg *)",
      "Bash(wc *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(touch *)",
      "Bash(chmod *)",
      "Bash(pkg-config *)",
      "Bash(which *)",
      "Bash(command -v *)",
      "Bash(file *)",
      "Bash(jq *)",
      "Bash(stat *)",
      "Bash(du *)",
      "Bash(realpath *)",
      "Bash(basename *)",
      "Bash(dirname *)",

      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(grep *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(tr *)",
      "Bash(cut *)",
      "Bash(diff *)",
      "Bash(tee *)",
      "Bash(xargs *)",
      "Bash(printf *)",
      "Bash(echo *)",

      "Bash(timeout *)",
      "Bash(nproc)",
      "Bash(date *)",
      "Bash(env)",
      "Bash(set *)",
      "Bash(test *)",
      "Bash(true)",
      "Bash(false)",
      "Bash(pkill *)",
      "Bash(python3 *)",
      "Bash(tar *)",
      "Bash(zip *)",
      "Bash(unzip *)"
